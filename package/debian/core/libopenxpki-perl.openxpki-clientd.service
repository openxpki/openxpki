[Unit]
Description=OpenXPKI Trustcenter Frontend
Documentation=https://openxpki.readthedocs.io/en/master/frontend/webservice.html
After=network.target openxpki-server.service
Requires=openxpki-serverd.service

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=30s
PIDFile=/run/openxpki-clientd/openxpki-clientd.pid
ExecStart=/usr/bin/openxpkictl start client --nd
User=openxpkiclient
Group=openxpkiclient
SupplementaryGroups=www-data

RuntimeDirectory=openxpki-clientd
RuntimeDirectoryMode=0755
TimeoutStartSec=30s
TimeoutStopSec=10s
Restart=on-failure
PrivateTmp=true

[Install]
WantedBy=multi-user.target
