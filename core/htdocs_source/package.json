{
  "//": [
    "@ember/string - required by ember-bootstrap",
    "'ember test' uses testem (configured in testem.js) and Vite handles the",
    "build step internally via Embroider."
  ],
  "name": "openxpki",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "repository": "",
  "license": "Apache-2.0",
  "author": "",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "config": {
    "outputpath": "dist"
  },
  "scripts": {
    "build": "vite build",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "concurrently \"npm:lint:css -- --fix\"",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "serve": "vite --host=0.0.0.0",
    "test:ember": "vite build --mode development && ember test --path $OPENXPKI_BUILD_OUTPUT_PATH",
    "docs": "jsdoc -c .jsdoc.js --verbose app"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/plugin-syntax-decorators": "^7.28.6",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/runtime": "^7.28.6",
    "@ember/optional-features": "^3.0.0",
    "@ember/string": "^4.0.1",
    "@ember/test-helpers": "^5.4.1",
    "@embroider/compat": "^4.1.13",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.4.3",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.19.7",
    "@embroider/router": "^3.0.6",
    "@embroider/vite": "^1.5.2",
    "@eslint/js": "^10.0.1",
    "@glimmer/component": "^2.0.0",
    "@glimmer/tracking": "^1.1.2",
    "@rollup/plugin-babel": "^6.1.0",
    "@warp-drive/build-config": "~5.8.1",
    "@warp-drive/core": "~5.8.1",
    "@warp-drive/ember": "~5.8.1",
    "@warp-drive/json-api": "~5.8.1",
    "@warp-drive/legacy": "~5.8.1",
    "@warp-drive/utilities": "~5.8.1",
    "babel-plugin-ember-template-compilation": "^3.1.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "caniuse-lite": "^1.0.30001778",
    "choices.js": "^11.2.1",
    "concurrently": "^9.2.1",
    "copy-text-to-clipboard": "^3.2.2",
    "decorator-transforms": "^2.3.1",
    "detect-browser": "^5.3.0",
    "ember-auto-import": "^2.0.0",
    "ember-bootstrap": "^6.7.0",
    "ember-cli": "^6.11.0",
    "ember-cli-babel": "^8.3.1",
    "ember-cli-htmlbars": "^7.0.0",
    "ember-cli-sass": "^11.0.1",
    "ember-cli-update": "^3.0.1",
    "ember-eslint-parser": "^0.7.0",
    "ember-flatpickr": "^9.0.2",
    "ember-intl": "^8.2.0",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.0.4",
    "ember-resolver": "^13.2.0",
    "ember-source": "~6.11.0",
    "ember-template-lint": "^7.9.3",
    "ember-tippy": "^3.0.0-beta.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-qunit": "^8.2.6",
    "eslint-plugin-warp-drive": "^5.8.1",
    "flatpickr": "^4.6.13",
    "globals": "^17.4.0",
    "js-yaml": "^4.1.1",
    "jsdoc": "^4.0.5",
    "luxon": "^3.7.2",
    "pretender": "^3.4.7",
    "prettier": "^3.8.1",
    "prettier-plugin-ember-template-tag": "^2.1.3",
    "qunit": "^2.25.0",
    "qunit-dom": "^3.5.0",
    "sass": "^1.98.0",
    "stylelint": "^17.4.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-prettier": "^5.0.3",
    "superstruct": "^2.0.2",
    "tippy.js": "^6.3.7",
    "uplot": "^1.6.32",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">= 20"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-bootstrap": {
    "bootstrapVersion": 5,
    "importBootstrapCSS": false,
    "insertEmberWormholeElementToDom": false,
    "include": ["bs-button", "bs-modal", "bs-dropdown", "bs-navbar", "bs-collapse"]
  },
  "pnpm": {
    "overrides": {
      "babel-plugin-ember-template-compilation": "2.3.0"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "core-js",
      "esbuild"
    ]
  }
}
