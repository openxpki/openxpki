{
  "//": [
    "Tests use testem directly (configured in testem.js); Vite handles the",
    "build step internally via Embroider."
  ],
  "name": "openxpki",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "repository": "",
  "license": "Apache-2.0",
  "author": "",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "config": {
    "outputpath": "dist"
  },
  "scripts": {
    "build": "vite build",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "serve": "vite --host=0.0.0.0",
    "test:ember": "vite build --mode development && testem ci",
    "docs": "jsdoc -c .jsdoc.js --verbose app"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/runtime": "^7.28.6",
    "@ember/optional-features": "^3.0.0",
    "@ember/test-helpers": "^5.4.1",
    "@embroider/compat": "^4.1.13",
    "@embroider/core": "^4.4.3",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.19.7",
    "@embroider/router": "^3.0.6",
    "@embroider/vite": "^1.5.2",
    "@eslint/js": "^10.0.1",
    "@glimmer/component": "^2.0.0",
    "@rollup/plugin-babel": "^6.1.0",
    "babel-plugin-ember-template-compilation": "^3.1.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "caniuse-lite": "^1.0.30001778",
    "choices.js": "^11.2.1",
    "copy-text-to-clipboard": "^3.2.2",
    "decorator-transforms": "^2.3.1",
    "detect-browser": "^5.3.0",
    "ember-eslint-parser": "^0.7.0",
    "ember-intl": "^8.2.0",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.0.4",
    "ember-resolver": "^13.2.0",
    "ember-source": "~6.11.0",
    "ember-template-lint": "^7.9.3",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-qunit": "^8.2.6",
    "flatpickr": "^4.6.13",
    "globals": "^17.4.0",
    "js-yaml": "^4.1.1",
    "jsdoc": "^4.0.5",
    "luxon": "^3.7.2",
    "pretender": "^3.4.7",
    "prettier": "^3.8.1",
    "prettier-plugin-ember-template-tag": "^2.1.3",
    "qunit": "^2.25.0",
    "qunit-dom": "^3.5.0",
    "sass": "^1.98.0",
    "testem": "^3.18.0",
    "tippy.js": "^6.3.7",
    "uplot": "^1.6.32",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">= 20"
  },
  "ember": {
    "edition": "octane"
  },
  "pnpm": {
    "overrides": {
      "babel-plugin-ember-template-compilation": "2.3.0"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "core-js",
      "esbuild"
    ]
  }
}
