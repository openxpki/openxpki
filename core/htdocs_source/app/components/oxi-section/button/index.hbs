<!-- components/oxi-section/button -->
<OxiBase::Button @button={{this.button}}>
    {{#if @def.image}}
        <div class="oxi-section-button-image">
            <img src={{@def.image}} alt="" />
        </div>
    {{else if this.icon}}
        <div class="oxi-section-button-icon {{this.icon}}"></div>
    {{/if}}
    <div class="text-start">
        {{@def.description}}
    </div>
</OxiBase::Button>
